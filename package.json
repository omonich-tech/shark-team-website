{
  "name": "shark-team-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:verify": "tsx scripts/verify-core-data.ts",
    "db:studio": "prisma studio",
    "db:sessions": "tsx scripts/generate-sessions.ts",
    "db:verify-sessions": "tsx scripts/verify-sessions.ts",
    "db:migration:print": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:bootstrap": "npm run db:migrate:deploy && npm run db:seed && npm run db:sessions",
    "db:prepare-booking-smoke": "tsx scripts/prepare-booking-smoke.ts",
    "smoke:booking": "node scripts/smoke-booking-http.mjs",
    "verify:hold-window": "tsx scripts/verify-hold-window.ts",
    "smoke:reservation-race": "node scripts/smoke-reservation-race.mjs",
    "verify:expired-hold": "tsx scripts/verify-expired-hold-reclaim.ts",
    "db:expire-trial-holds": "tsx scripts/expire-trial-bookings.ts",
    "smoke:payme": "node scripts/smoke-payme-http.mjs",
    "db:prepare-coach-smoke": "tsx scripts/prepare-coach-smoke.ts",
    "smoke:coach": "tsx scripts/smoke-coach-http.ts",
    "telegram:set-webhook": "tsx scripts/set-telegram-webhook.ts",
    "notifications:run": "tsx scripts/process-notifications.ts",
    "smoke:telegram": "tsx scripts/smoke-telegram-http.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.6",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
}
