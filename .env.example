# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shark_team"
DATABASE_POOL_MAX=3

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payme Business
PAYME_MERCHANT_ID=
PAYME_LOGIN=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz/

# Temporary manual card payment
MANUAL_PAYMENT_CARD_NUMBER=
MANUAL_PAYMENT_CARD_HOLDER=

# Owner-only CRM access (MVP)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Keep unset/true in production. Set false only for local HTTP testing.
ADMIN_COOKIE_SECURE=

# Coach dashboard
COACH_SESSION_SECRET=
# Keep unset/true in production. Set false only for local HTTP testing.
COACH_COOKIE_SECURE=

# Telegram bot and notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Private admin group used to review manual payment receipts
TELEGRAM_ADMIN_CHAT_ID=
# Optional comma-separated Telegram user IDs allowed to approve/reject payments
TELEGRAM_ADMIN_USER_IDS=
CRON_SECRET=
TRIAL_REMINDER_MINUTES=180
POST_TRIAL_FEEDBACK_MINUTES=30

# Optional AI fallback for free-text Telegram questions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# CI/local-only transport bypass. Never enable in production.
TELEGRAM_DRY_RUN=false

# Vercel Blob media storage
BLOB_READ_WRITE_TOKEN=

# CI/local only. Never enable in production.
MEDIA_DRY_RUN=false

# Production security / maintenance
RATE_LIMIT_SALT=
MAINTENANCE_SESSION_HORIZON_DAYS=84

# Optional public fallback contact
PUBLIC_CONTACT_PHONE=
