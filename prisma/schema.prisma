generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LifecycleStatus {
  DRAFT
  ACTIVE
  PAUSED
  INACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  OPEN
  PAUSED
  CLOSED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PriceProductType {
  TRIAL
  SUBSCRIPTION
}

enum LeadStatus {
  NEW
  TRIAL_SELECTED
  TRIAL_HELD
  TRIAL_CONFIRMED
  CLOSED
}

enum TrialBookingStatus {
  HOLD
  PAYMENT_PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum PaymentProvider {
  PAYME
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum StudentEnrollmentStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum NotificationChannel {
  TELEGRAM
}

enum NotificationType {
  PAYMENT_HOLD_REMINDER
  TRIAL_CONFIRMED
  TRIAL_REMINDER
  POST_TRIAL_FEEDBACK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Sport {
  id                 String          @id
  slug               String          @unique
  status             LifecycleStatus @default(DRAFT)
  nameRu             String
  nameUz             String
  shortDescriptionRu String?
  shortDescriptionUz String?
  ageMin             Int?
  ageMax             Int?
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  branchLinks BranchSport[]
  coachLinks  CoachSport[]
  groups      TrainingGroup[]
  prices      Price[]
  leads       Lead[]

  @@index([status, sortOrder])
}

model Branch {
  id               String          @id
  slug             String          @unique
  status           LifecycleStatus @default(DRAFT)
  internalName     String
  publicNameRu     String
  publicNameUz     String
  districtRu       String?
  districtUz       String?
  addressRu        String
  addressUz        String
  postalCode       String?
  landmarkRu       String?
  landmarkUz       String?
  entranceNoteRu   String?
  entranceNoteUz   String?
  latitude         Decimal?        @db.Decimal(9, 6)
  longitude        Decimal?        @db.Decimal(9, 6)
  publicPhone      String?
  workingHoursRu   String?
  workingHoursUz   String?
  facilityNotesRu  String?
  facilityNotesUz  String?
  timezone         String          @default("Asia/Tashkent")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sportLinks BranchSport[]
  coachLinks CoachBranch[]
  groups     TrainingGroup[]
  prices     Price[]
  leads      Lead[]

  @@index([status])
}

model BranchSport {
  branchId String
  sportId  String
  status   LifecycleStatus @default(ACTIVE)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sport  Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([branchId, sportId])
  @@index([sportId, status])
}

model Coach {
  id                 String          @id
  status             LifecycleStatus @default(ACTIVE)
  firstName          String
  lastName           String?
  phonePrivate       String?
  experienceYears    Int?
  educationRu        String?
  educationUz        String?
  qualificationRu    String?
  qualificationUz    String?
  publicBioRu        String?
  publicBioUz        String?
  startedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  sportLinks   CoachSport[]
  branchLinks  CoachBranch[]
  primaryGroups TrainingGroup[] @relation("PrimaryCoach")
  sessions      TrainingSession[]
  account       CoachAccount?
  attendances   Attendance[]
  assessments   TrialAssessment[]

  @@index([status])
}

model CoachSport {
  coachId String
  sportId String
  status  LifecycleStatus @default(ACTIVE)

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([coachId, sportId])
}

model CoachBranch {
  coachId  String
  branchId String
  status   LifecycleStatus @default(ACTIVE)

  coach  Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([coachId, branchId])
}

model TrainingGroup {
  id                 String           @id
  branchId           String
  sportId            String
  primaryCoachId     String
  internalName       String
  status             LifecycleStatus  @default(ACTIVE)
  enrollmentStatus   EnrollmentStatus @default(OPEN)
  ageMin             Int
  ageMax             Int
  capacityRegular    Int
  capacityTrial      Int?
  level              String?
  startDate          DateTime?
  endDate            DateTime?
  notesInternal      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  branch       Branch              @relation(fields: [branchId], references: [id])
  sport        Sport               @relation(fields: [sportId], references: [id])
  primaryCoach Coach               @relation("PrimaryCoach", fields: [primaryCoachId], references: [id])
  scheduleRules GroupScheduleRule[]
  sessions      TrainingSession[]
  prices        Price[]
  leads         Lead[]
  enrollments   StudentEnrollment[]

  @@index([branchId, sportId, status])
  @@index([primaryCoachId, status])
  @@index([ageMin, ageMax])
}

model GroupScheduleRule {
  id           String          @id
  groupId      String
  weekday      Weekday
  startMinutes Int
  endMinutes   Int
  validFrom    DateTime?
  validTo      DateTime?
  status       LifecycleStatus @default(ACTIVE)

  group    TrainingGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sessions TrainingSession[]

  @@unique([groupId, weekday, startMinutes, validFrom])
  @@index([groupId, status])
}

model TrainingSession {
  id                  String        @id @default(cuid())
  groupId             String
  coachId             String
  scheduleRuleId      String?
  sourceDate          DateTime?     @db.Date
  startsAt            DateTime
  endsAt              DateTime
  status              SessionStatus @default(SCHEDULED)
  regularCapacity     Int
  trialCapacity       Int?
  trialBookingEnabled Boolean       @default(false)
  cancellationReason  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  group        TrainingGroup      @relation(fields: [groupId], references: [id])
  coach        Coach              @relation(fields: [coachId], references: [id])
  scheduleRule GroupScheduleRule? @relation(fields: [scheduleRuleId], references: [id])
  leads        Lead[]
  trialBookings TrialBooking[]
  attendances   Attendance[]

  @@unique([groupId, startsAt])
  @@unique([scheduleRuleId, sourceDate])
  @@index([coachId, startsAt, status])
  @@index([startsAt, status])
  @@index([groupId, sourceDate])
}

model Price {
  id          String           @id
  productType PriceProductType
  amount      Int
  currency    String           @default("UZS")
  sportId     String?
  branchId    String?
  groupId     String?
  validFrom   DateTime         @default(now())
  validTo     DateTime?
  status      LifecycleStatus  @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sport  Sport?         @relation(fields: [sportId], references: [id])
  branch Branch?        @relation(fields: [branchId], references: [id])
  group  TrainingGroup? @relation(fields: [groupId], references: [id])

  @@index([productType, status, validFrom])
  @@index([branchId, sportId, groupId])
}

model Lead {
  id                String     @id @default(cuid())
  status            LeadStatus @default(NEW)
  parentName        String
  childName         String
  phone             String
  childAge          Int
  locale            String     @default("ru")
  source            String     @default("website")
  branchId          String?
  sportId           String?
  groupId           String?
  selectedSessionId String?
  parentId          String?
  childId           String?
  landingPage       String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sport           Sport?           @relation(fields: [sportId], references: [id], onDelete: SetNull)
  group           TrainingGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  selectedSession TrainingSession? @relation(fields: [selectedSessionId], references: [id], onDelete: SetNull)
  parent          Parent?          @relation(fields: [parentId], references: [id], onDelete: SetNull)
  child           Child?           @relation(fields: [childId], references: [id], onDelete: SetNull)
  trialBookings      TrialBooking[]
  telegramContacts   TelegramContact[]
  telegramLinkTokens TelegramLinkToken[]
  notifications      Notification[]

  @@index([phone, status])
  @@index([selectedSessionId])
  @@index([parentId])
  @@index([childId])
  @@index([createdAt])
}

model TrialBooking {
  id             String             @id @default(cuid())
  leadId         String
  sessionId      String
  status         TrialBookingStatus @default(HOLD)
  expiresAt      DateTime
  reminderAt     DateTime?
  reminderSentAt DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lead    Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payment       Payment?
  attendance    Attendance?
  assessment    TrialAssessment?
  notifications Notification[]

  @@unique([leadId, sessionId])
  @@index([sessionId, status, expiresAt])
  @@index([status, expiresAt])
}

model Payment {
  id             String          @id @default(cuid())
  trialBookingId String          @unique
  provider       PaymentProvider @default(PAYME)
  status         PaymentStatus   @default(PENDING)
  amountUzs      Int
  amountTiyin    Int
  currency       String          @default("UZS")
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  trialBooking     TrialBooking       @relation(fields: [trialBookingId], references: [id], onDelete: Cascade)
  paymeTransactions PaymeTransaction[]

  @@index([provider, status])
  @@index([createdAt])
}

model PaymeTransaction {
  id                    String   @id @default(cuid())
  paymentId             String
  providerTransactionId String   @unique
  requestTime           BigInt
  amountTiyin           Int
  state                 Int
  reason                Int?
  merchantCreateTime    DateTime
  merchantPerformTime   DateTime?
  merchantCancelTime    DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, state])
  @@index([requestTime])
}

model Parent {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  locale    String   @default("ru")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children         Child[]
  leads            Lead[]
  telegramContacts TelegramContact[]
  notifications    Notification[]

  @@index([createdAt])
}

model Child {
  id                String   @id @default(cuid())
  parentId          String
  name              String
  ageAtRegistration Int
  dateOfBirth       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parent      Parent              @relation(fields: [parentId], references: [id], onDelete: Cascade)
  leads       Lead[]
  enrollments StudentEnrollment[]
  attendances Attendance[]

  @@index([parentId])
  @@index([createdAt])
}

model CoachAccount {
  id           String   @id @default(cuid())
  coachId      String   @unique
  username     String   @unique
  passwordHash String
  passwordSalt String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model StudentEnrollment {
  id        String                  @id @default(cuid())
  childId   String
  groupId   String
  status    StudentEnrollmentStatus @default(ACTIVE)
  startDate DateTime                @default(now())
  endDate   DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  child Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  group TrainingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([childId, status])
  @@index([groupId, status])
}

model Attendance {
  id             String           @id @default(cuid())
  sessionId      String
  childId        String
  coachId        String
  trialBookingId String?          @unique
  status         AttendanceStatus
  markedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  child        Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  coach        Coach           @relation(fields: [coachId], references: [id], onDelete: Restrict)
  trialBooking TrialBooking?   @relation(fields: [trialBookingId], references: [id], onDelete: SetNull)

  @@unique([sessionId, childId])
  @@index([coachId, markedAt])
  @@index([childId, markedAt])
}

model TrialAssessment {
  id                     String   @id @default(cuid())
  trialBookingId         String   @unique
  coachId                String
  ability                Int
  discipline             Int
  motivation             Int
  coordination           Int
  physicalPreparation    Int
  psychologicalReadiness Int
  coachComment           String?
  recommendation         String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  trialBooking TrialBooking @relation(fields: [trialBookingId], references: [id], onDelete: Cascade)
  coach        Coach        @relation(fields: [coachId], references: [id], onDelete: Restrict)

  @@index([coachId, createdAt])
}

model TelegramContact {
  id             String   @id @default(cuid())
  leadId         String?
  parentId       String?
  telegramUserId BigInt   @unique
  chatId         BigInt   @unique
  username       String?
  firstName      String?
  languageCode   String?
  locale         String   @default("ru")
  verifiedAt     DateTime @default(now())
  lastMessageAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  parent Parent? @relation(fields: [parentId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([parentId])
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  leadId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, expiresAt])
}

model Notification {
  id               String              @id @default(cuid())
  channel          NotificationChannel @default(TELEGRAM)
  type             NotificationType
  status           NotificationStatus  @default(PENDING)
  leadId           String?
  parentId         String?
  trialBookingId   String?
  scheduledAt      DateTime
  sentAt           DateTime?
  attempts         Int                 @default(0)
  externalMessageId String?
  lastError        String?
  dedupeKey        String              @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  parent       Parent?       @relation(fields: [parentId], references: [id], onDelete: SetNull)
  trialBooking TrialBooking? @relation(fields: [trialBookingId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([leadId])
  @@index([parentId])
  @@index([trialBookingId])
}
