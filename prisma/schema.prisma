generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LifecycleStatus {
  DRAFT
  ACTIVE
  PAUSED
  INACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  OPEN
  PAUSED
  CLOSED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PriceProductType {
  TRIAL
  SUBSCRIPTION
}

enum LeadStatus {
  NEW
  TRIAL_SELECTED
  TRIAL_HELD
  TRIAL_CONFIRMED
  CLOSED
}

enum TrialBookingStatus {
  HOLD
  PAYMENT_PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum PaymentProvider {
  PAYME
  MANUAL_CARD
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  PAID
  REJECTED
  CANCELLED
  REFUNDED
}

enum StudentEnrollmentStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum SubscriptionStatus {
  ACTIVE
  PAYMENT_DUE
  PAST_DUE
  FROZEN
  PAUSED
  ENDED
}

enum SubscriptionFreezeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TrialConversionStatus {
  READY
  THINKING
  OFFERED
  PAYMENT_PENDING
  ENROLLED
  DECLINED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum AbsenceReason {
  ILLNESS
  FAMILY
  TRAVEL
  SCHOOL
  OTHER
}

enum AttendanceReasonSource {
  COACH
  PARENT
  ADMIN
}

enum NotificationChannel {
  TELEGRAM
}

enum NotificationType {
  PAYMENT_HOLD_REMINDER
  TRIAL_CONFIRMED
  TRIAL_REMINDER
  POST_TRIAL_FEEDBACK
  SUBSCRIPTION_RENEWAL_REMINDER
  SUBSCRIPTION_PAST_DUE
  SUBSCRIPTION_FROZEN
  SUBSCRIPTION_RESUMED
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_ENDED
  REGULAR_ABSENCE_NOTICE
  REGULAR_SESSION_REMINDER
  REGULAR_SESSION_CANCELLED
  REGULAR_SESSION_RESCHEDULED
  STUDENT_PROGRESS_UPDATE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaTargetType {
  BRANCH
  COACH
  SPORT
  GROUP
  PAGE
}

enum MediaCategory {
  MAIN
  FACADE
  ENTRANCE
  HALL
  TRAINING
  EQUIPMENT
  COACH_PROFILE
  OTHER
}

enum MediaConsentStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum AuditActorType {
  ADMIN
  COACH
  SYSTEM
}

enum OperationalAlertType {
  ATTENDANCE_RISK
  PROGRESS_OVERDUE
  PAYMENT_ATTENTION
}

enum OperationalAlertStatus {
  OPEN
  RESOLVED
}

model Sport {
  id                 String          @id
  slug               String          @unique
  status             LifecycleStatus @default(DRAFT)
  nameRu             String
  nameUz             String
  shortDescriptionRu String?
  shortDescriptionUz String?
  seoTitleRu         String?
  seoTitleUz         String?
  seoDescriptionRu   String?
  seoDescriptionUz   String?
  ageMin             Int?
  ageMax             Int?
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  branchLinks BranchSport[]
  coachLinks  CoachSport[]
  groups      TrainingGroup[]
  prices      Price[]
  leads       Lead[]
  faqs        FaqItem[]

  @@index([status, sortOrder])
}

model Branch {
  id               String          @id
  slug             String          @unique
  status           LifecycleStatus @default(DRAFT)
  internalName     String
  publicNameRu     String
  publicNameUz     String
  districtRu       String?
  districtUz       String?
  addressRu        String
  addressUz        String
  postalCode       String?
  landmarkRu       String?
  landmarkUz       String?
  entranceNoteRu   String?
  entranceNoteUz   String?
  latitude         Decimal?        @db.Decimal(9, 6)
  longitude        Decimal?        @db.Decimal(9, 6)
  publicPhone      String?
  workingHoursRu   String?
  workingHoursUz   String?
  facilityNotesRu  String?
  facilityNotesUz  String?
  seoTitleRu       String?
  seoTitleUz       String?
  seoDescriptionRu String?
  seoDescriptionUz String?
  timezone         String          @default("Asia/Tashkent")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sportLinks BranchSport[]
  coachLinks CoachBranch[]
  groups     TrainingGroup[]
  prices     Price[]
  leads      Lead[]
  faqs       FaqItem[]

  @@index([status])
}

model BranchSport {
  branchId String
  sportId  String
  status   LifecycleStatus @default(ACTIVE)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sport  Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([branchId, sportId])
  @@index([sportId, status])
}

model Coach {
  id                 String          @id
  status             LifecycleStatus @default(ACTIVE)
  firstName          String
  lastName           String?
  phonePrivate       String?
  experienceYears    Int?
  educationRu        String?
  educationUz        String?
  qualificationRu    String?
  qualificationUz    String?
  publicBioRu        String?
  publicBioUz        String?
  seoTitleRu         String?
  seoTitleUz         String?
  seoDescriptionRu   String?
  seoDescriptionUz   String?
  startedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  sportLinks   CoachSport[]
  branchLinks  CoachBranch[]
  primaryGroups TrainingGroup[] @relation("PrimaryCoach")
  sessions      TrainingSession[]
  account       CoachAccount?
  attendances   Attendance[]
  assessments   TrialAssessment[]
  progressAssessments StudentProgressAssessment[]

  @@index([status])
}

model CoachSport {
  coachId String
  sportId String
  status  LifecycleStatus @default(ACTIVE)

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([coachId, sportId])
}

model CoachBranch {
  coachId  String
  branchId String
  status   LifecycleStatus @default(ACTIVE)

  coach  Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([coachId, branchId])
}

model TrainingGroup {
  id                 String           @id
  branchId           String
  sportId            String
  primaryCoachId     String
  internalName       String
  status             LifecycleStatus  @default(ACTIVE)
  enrollmentStatus   EnrollmentStatus @default(OPEN)
  ageMin             Int
  ageMax             Int
  capacityRegular    Int
  capacityTrial      Int?
  level              String?
  startDate          DateTime?
  endDate            DateTime?
  notesInternal      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  branch       Branch              @relation(fields: [branchId], references: [id])
  sport        Sport               @relation(fields: [sportId], references: [id])
  primaryCoach Coach               @relation("PrimaryCoach", fields: [primaryCoachId], references: [id])
  scheduleRules GroupScheduleRule[]
  sessions      TrainingSession[]
  prices        Price[]
  leads         Lead[]
  enrollments   StudentEnrollment[]
  trialConversions TrialConversion[]
  progressAssessments StudentProgressAssessment[]
  operationalAlerts OperationalAlert[]

  @@index([branchId, sportId, status])
  @@index([primaryCoachId, status])
  @@index([ageMin, ageMax])
}

model GroupScheduleRule {
  id           String          @id
  groupId      String
  weekday      Weekday
  startMinutes Int
  endMinutes   Int
  validFrom    DateTime?
  validTo      DateTime?
  status       LifecycleStatus @default(ACTIVE)

  group    TrainingGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sessions TrainingSession[]

  @@unique([groupId, weekday, startMinutes, validFrom])
  @@index([groupId, status])
}

model TrainingSession {
  id                  String        @id @default(cuid())
  groupId             String
  coachId             String
  scheduleRuleId      String?
  sourceDate          DateTime?     @db.Date
  startsAt            DateTime
  endsAt              DateTime
  status              SessionStatus @default(SCHEDULED)
  regularCapacity     Int
  trialCapacity       Int?
  trialBookingEnabled Boolean       @default(false)
  cancellationReason  String?
  completedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  group        TrainingGroup      @relation(fields: [groupId], references: [id])
  coach        Coach              @relation(fields: [coachId], references: [id])
  scheduleRule GroupScheduleRule? @relation(fields: [scheduleRuleId], references: [id])
  leads        Lead[]
  trialBookings TrialBooking[]
  attendances   Attendance[]
  notifications Notification[]

  @@unique([groupId, startsAt])
  @@unique([scheduleRuleId, sourceDate])
  @@index([coachId, startsAt, status])
  @@index([startsAt, status])
  @@index([groupId, sourceDate])
}

model Price {
  id          String           @id
  productType PriceProductType
  amount      Int
  currency    String           @default("UZS")
  sportId     String?
  branchId    String?
  groupId     String?
  validFrom   DateTime         @default(now())
  validTo     DateTime?
  status      LifecycleStatus  @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sport  Sport?         @relation(fields: [sportId], references: [id])
  branch Branch?        @relation(fields: [branchId], references: [id])
  group  TrainingGroup? @relation(fields: [groupId], references: [id])

  @@index([productType, status, validFrom])
  @@index([branchId, sportId, groupId])
}

model Lead {
  id                String     @id @default(cuid())
  status            LeadStatus @default(NEW)
  parentName        String
  childName         String
  phone             String
  childAge          Int
  locale            String     @default("ru")
  source            String     @default("website")
  branchId          String?
  sportId           String?
  groupId           String?
  selectedSessionId String?
  parentId          String?
  childId           String?
  landingPage       String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  analyticsVisitorId String?
  analyticsSessionId String?
  analyticsPageViewId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sport           Sport?           @relation(fields: [sportId], references: [id], onDelete: SetNull)
  group           TrainingGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  selectedSession TrainingSession? @relation(fields: [selectedSessionId], references: [id], onDelete: SetNull)
  parent          Parent?          @relation(fields: [parentId], references: [id], onDelete: SetNull)
  child           Child?           @relation(fields: [childId], references: [id], onDelete: SetNull)
  trialBookings      TrialBooking[]
  telegramContacts   TelegramContact[]
  telegramLinkTokens TelegramLinkToken[]
  notifications      Notification[]

  @@index([phone, status])
  @@index([selectedSessionId])
  @@index([parentId])
  @@index([childId])
  @@index([createdAt])
  @@index([analyticsVisitorId, createdAt])
}

model TrialBooking {
  id             String             @id @default(cuid())
  leadId         String
  sessionId      String
  status         TrialBookingStatus @default(HOLD)
  expiresAt      DateTime
  reminderAt     DateTime?
  reminderSentAt DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lead    Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payment       Payment?
  attendance    Attendance?
  assessment    TrialAssessment?
  feedback      TrialFeedback?
  conversion    TrialConversion?
  notifications Notification[]

  @@unique([leadId, sessionId])
  @@index([sessionId, status, expiresAt])
  @@index([status, expiresAt])
}

model Payment {
  id              String          @id @default(cuid())
  trialBookingId  String          @unique
  provider        PaymentProvider @default(PAYME)
  status          PaymentStatus   @default(PENDING)
  amountUzs       Int
  amountTiyin     Int
  currency        String          @default("UZS")
  receiptUrl      String?
  receiptPathname String?
  receiptMimeType String?
  receiptSize     Int?
  receiptTelegramFileId String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  trialBooking      TrialBooking       @relation(fields: [trialBookingId], references: [id], onDelete: Cascade)
  paymeTransactions PaymeTransaction[]

  @@index([provider, status])
  @@index([status, submittedAt])
  @@index([createdAt])
}

model PaymeTransaction {
  id                    String   @id @default(cuid())
  paymentId             String
  providerTransactionId String   @unique
  requestTime           BigInt
  amountTiyin           Int
  state                 Int
  reason                Int?
  merchantCreateTime    DateTime
  merchantPerformTime   DateTime?
  merchantCancelTime    DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, state])
  @@index([requestTime])
}

model Parent {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  locale    String   @default("ru")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children         Child[]
  leads            Lead[]
  telegramContacts TelegramContact[]
  notifications    Notification[]
  trialFeedbacks   TrialFeedback[]
  subscriptionFreezeRequests SubscriptionFreezeRequest[]

  @@index([createdAt])
}

model Child {
  id                String   @id @default(cuid())
  parentId          String
  name              String
  ageAtRegistration Int
  dateOfBirth       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parent      Parent              @relation(fields: [parentId], references: [id], onDelete: Cascade)
  leads       Lead[]
  enrollments StudentEnrollment[]
  attendances Attendance[]
  trialConversions TrialConversion[]
  progressAssessments StudentProgressAssessment[]
  adminNotes StudentAdminNote[]
  operationalAlerts OperationalAlert[]

  @@index([parentId])
  @@index([createdAt])
}

model OperationalAlert {
  id           String                 @id @default(cuid())
  type         OperationalAlertType
  status       OperationalAlertStatus @default(OPEN)
  severity     String                 @default("warning")
  childId      String?
  enrollmentId String?
  groupId      String?
  title        String
  details      String?
  dedupeKey    String                 @unique
  openedAt     DateTime               @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  child      Child?             @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  group      TrainingGroup?     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([status, type, openedAt])
  @@index([childId, status])
  @@index([groupId, status])
  @@index([enrollmentId, status])
}

model StudentAdminNote {
  id        String   @id @default(cuid())
  childId   String
  authorId  String?
  note      String
  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
  @@index([authorId, createdAt])
}

model CoachAccount {
  id           String   @id @default(cuid())
  coachId      String   @unique
  username     String   @unique
  passwordHash String
  passwordSalt String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model StudentEnrollment {
  id                 String                  @id @default(cuid())
  childId            String
  groupId            String
  status             StudentEnrollmentStatus @default(ACTIVE)
  subscriptionStatus SubscriptionStatus?
  startDate          DateTime                 @default(now())
  endDate            DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextPaymentDueAt   DateTime?
  graceUntil         DateTime?
  pausedAt           DateTime?
  freezeStartedAt    DateTime?
  freezeUntil        DateTime?
  freezeReason       String?
  endReason          String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  child    Child                 @relation(fields: [childId], references: [id], onDelete: Cascade)
  group    TrainingGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payments      SubscriptionPayment[]
  notifications Notification[]
  operationalAlerts OperationalAlert[]
  freezeRequests SubscriptionFreezeRequest[]

  @@index([childId, status])
  @@index([groupId, status])
  @@index([subscriptionStatus, nextPaymentDueAt])
  @@index([subscriptionStatus, freezeUntil])
}

model SubscriptionFreezeRequest {
  id           String                          @id @default(cuid())
  enrollmentId String
  parentId     String
  days         Int
  reason       String
  status       SubscriptionFreezeRequestStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedBy   String?
  decisionNote String?
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt

  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  parent     Parent            @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, status, createdAt])
  @@index([parentId, status, createdAt])
  @@index([status, createdAt])
}

model TrialConversion {
  id             String                @id @default(cuid())
  trialBookingId String                @unique
  childId        String
  groupId        String
  status         TrialConversionStatus @default(READY)
  amountUzs      Int?
  currency       String                @default("UZS")
  offeredAt      DateTime?
  enrolledAt     DateTime?
  declinedAt     DateTime?
  adminNote      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  trialBooking TrialBooking        @relation(fields: [trialBookingId], references: [id], onDelete: Cascade)
  child        Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  group        TrainingGroup       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payments     SubscriptionPayment[]

  @@index([status, updatedAt])
  @@index([childId, status])
  @@index([groupId, status])
}

model SubscriptionPayment {
  id                      String          @id @default(cuid())
  trialConversionId       String
  enrollmentId            String?
  sequence                Int             @default(1)
  provider                PaymentProvider @default(MANUAL_CARD)
  status                  PaymentStatus   @default(PENDING)
  amountUzs               Int
  currency                String          @default("UZS")
  periodStart             DateTime?
  periodEnd               DateTime?
  dueAt                   DateTime?
  receiptMimeType         String?
  receiptSize             Int?
  receiptTelegramFileId   String?
  submittedAt             DateTime?
  reviewedAt              DateTime?
  reviewedBy              String?
  rejectionReason         String?
  paidAt                  DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  trialConversion TrialConversion   @relation(fields: [trialConversionId], references: [id], onDelete: Cascade)
  enrollment      StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  notifications   Notification[]
  selectedByTelegramContacts TelegramContact[] @relation("TelegramSelectedSubscriptionPayment")

  @@unique([trialConversionId, sequence])
  @@index([enrollmentId, status])
  @@index([provider, status])
  @@index([status, submittedAt])
  @@index([dueAt, status])
}

model Attendance {
  id             String           @id @default(cuid())
  sessionId      String
  childId        String
  coachId        String
  trialBookingId String?          @unique
  status         AttendanceStatus
  absenceReason  AbsenceReason?
  absenceNote    String?
  reasonSource   AttendanceReasonSource?
  reasonUpdatedAt DateTime?
  markedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  child        Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  coach        Coach           @relation(fields: [coachId], references: [id], onDelete: Restrict)
  trialBooking TrialBooking?   @relation(fields: [trialBookingId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@unique([sessionId, childId])
  @@index([coachId, markedAt])
  @@index([childId, markedAt])
}

model StudentProgressAssessment {
  id                     String   @id @default(cuid())
  childId                String
  groupId                String
  coachId                String
  ability                Int
  discipline             Int
  motivation             Int
  coordination           Int
  physicalPreparation    Int
  psychologicalReadiness Int
  coachComment           String?
  recommendation         String?
  assessedAt             DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  group TrainingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  coach Coach @relation(fields: [coachId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([childId, assessedAt])
  @@index([groupId, assessedAt])
  @@index([coachId, assessedAt])
}

model TrialAssessment {
  id                     String   @id @default(cuid())
  trialBookingId         String   @unique
  coachId                String
  ability                Int
  discipline             Int
  motivation             Int
  coordination           Int
  physicalPreparation    Int
  psychologicalReadiness Int
  coachComment           String?
  recommendation         String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  trialBooking TrialBooking @relation(fields: [trialBookingId], references: [id], onDelete: Cascade)
  coach        Coach        @relation(fields: [coachId], references: [id], onDelete: Restrict)

  @@index([coachId, createdAt])
}

model TrialFeedback {
  id              String   @id @default(cuid())
  trialBookingId  String   @unique
  parentId        String
  rating          Int
  comment         String?
  completedAt     DateTime?
  adminNotifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trialBooking TrialBooking @relation(fields: [trialBookingId], references: [id], onDelete: Cascade)
  parent       Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, createdAt])
  @@index([completedAt, adminNotifiedAt])
}

model TelegramContact {
  id             String   @id @default(cuid())
  leadId         String?
  parentId       String?
  telegramUserId BigInt   @unique
  chatId         BigInt   @unique
  username       String?
  firstName      String?
  languageCode   String?
  locale         String   @default("ru")
  verifiedAt     DateTime @default(now())
  lastMessageAt  DateTime?
  selectedSubscriptionPaymentId String?
  selectedSubscriptionPaymentAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  parent Parent? @relation(fields: [parentId], references: [id], onDelete: SetNull)
  selectedSubscriptionPayment SubscriptionPayment? @relation("TelegramSelectedSubscriptionPayment", fields: [selectedSubscriptionPaymentId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([parentId])
  @@index([selectedSubscriptionPaymentId])
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  leadId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, expiresAt])
}

model Notification {
  id               String              @id @default(cuid())
  channel          NotificationChannel @default(TELEGRAM)
  type             NotificationType
  status           NotificationStatus  @default(PENDING)
  leadId           String?
  parentId         String?
  trialBookingId   String?
  enrollmentId     String?
  subscriptionPaymentId String?
  attendanceId     String?
  progressAssessmentId String?
  trainingSessionId String?
  contextJson       Json?
  scheduledAt      DateTime
  sentAt           DateTime?
  attempts         Int                 @default(0)
  externalMessageId String?
  lastError        String?
  dedupeKey        String              @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  parent       Parent?       @relation(fields: [parentId], references: [id], onDelete: SetNull)
  trialBooking TrialBooking? @relation(fields: [trialBookingId], references: [id], onDelete: SetNull)
  enrollment StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  subscriptionPayment SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id], onDelete: SetNull)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  progressAssessment StudentProgressAssessment? @relation(fields: [progressAssessmentId], references: [id], onDelete: SetNull)
  trainingSession TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([leadId])
  @@index([parentId])
  @@index([trialBookingId])
  @@index([enrollmentId])
  @@index([subscriptionPaymentId])
  @@index([attendanceId])
  @@index([progressAssessmentId])
  @@index([trainingSessionId])
}


model ContentPage {
  id               String        @id @default(cuid())
  slug             String        @unique
  status           ContentStatus @default(DRAFT)
  heroEyebrowRu    String?
  heroEyebrowUz    String?
  heroTitleRu      String?
  heroTitleUz      String?
  heroLeadRu       String?
  heroLeadUz       String?
  bodyRu           String?
  bodyUz           String?
  contactPhone     String?
  contactTelegram  String?
  contactInstagram String?
  contactEmail     String?
  contactHoursRu   String?
  contactHoursUz   String?
  seoTitleRu       String?
  seoTitleUz       String?
  seoDescriptionRu String?
  seoDescriptionUz String?
  sectionsJson     Json?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
}

model FaqItem {
  id         String        @id @default(cuid())
  status     ContentStatus @default(DRAFT)
  branchId   String?
  sportId    String?
  questionRu String
  questionUz String
  answerRu   String
  answerUz   String
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sport  Sport?  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@index([status, sortOrder])
  @@index([branchId])
  @@index([sportId])
}

model MediaAsset {
  id             String             @id @default(cuid())
  targetType     MediaTargetType
  targetId       String
  category       MediaCategory      @default(OTHER)
  url            String
  pathname       String?
  contentType    String?
  size           Int?
  sortOrder      Int                @default(0)
  isPrimary      Boolean            @default(false)
  altRu          String?
  altUz          String?
  containsMinors Boolean            @default(false)
  consentStatus  MediaConsentStatus @default(NOT_REQUIRED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([targetType, targetId, sortOrder])
  @@index([targetType, targetId, isPrimary])
  @@index([consentStatus])
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
}


model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}


model WebPageView {
  id               String   @id
  visitorId        String
  sessionId        String
  path             String
  locale           String?
  referrerHost     String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  deviceType       String?
  viewportWidth    Int?
  startedAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  durationMs       Int      @default(0)
  maxScrollPercent Int      @default(0)

  clicks WebClick[]

  @@index([startedAt])
  @@index([visitorId, startedAt])
  @@index([sessionId, startedAt])
  @@index([path, startedAt])
  @@index([utmSource, startedAt])
  @@index([referrerHost, startedAt])
}

model WebClick {
  id         String   @id @default(cuid())
  pageViewId String
  visitorId  String
  sessionId  String
  path       String
  label      String?
  targetPath String?
  elementTag String?
  eventName  String   @default("click")
  occurredAt DateTime @default(now())

  pageView WebPageView @relation(fields: [pageViewId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([pageViewId, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([path, occurredAt])
  @@index([eventName, occurredAt])
}


model WebFunnelEvent {
  id         String   @id @default(cuid())
  visitorId  String
  sessionId  String
  pageViewId String?
  eventName  String
  path       String?
  sportSlug  String?
  branchSlug String?
  leadId     String?
  bookingId  String?
  paymentId  String?
  dedupeKey  String?  @unique
  occurredAt DateTime @default(now())

  @@index([occurredAt])
  @@index([eventName, occurredAt])
  @@index([visitorId, eventName, occurredAt])
  @@index([sessionId, eventName, occurredAt])
  @@index([leadId, eventName])
  @@index([bookingId, eventName])
  @@index([paymentId, eventName])
}
